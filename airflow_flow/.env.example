# Copier en .env (jamais commité)
AIRFLOW_UID=50000
# Base de métadonnées Airflow (distincte de la base météo)
AIRFLOW_DB_PASSWORD=change_me_airflowdb
# Secrets partagés (générer des valeurs aléatoires, voir README)
AIRFLOW_JWT_SECRET=change_me_long_random_string
AIRFLOW_FERNET_KEY=change_me_fernet_key
# Connexion vers la base météo (PostgreSQL du projet, publiée sur l'hôte Docker Desktop)
# Même mot de passe que POSTGRES_PASSWORD du .env racine ; encoder les caractères spéciaux (@ -> %40)
AIRFLOW_CONN_METEO_DB=postgresql://meteo:change_me@host.docker.internal:5432/meteo
